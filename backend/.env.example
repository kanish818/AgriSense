RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_PORT=8000
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ADMIN_API_KEY=your_local_admin_key_here
DATA_GOV_API_KEY=
TOMORROW_API_KEY=your_tomorrow_io_api_key_here
WEATHERAPI_KEY=your_weatherapi_key_here
OPENWEATHERMAP_KEY=your_openweathermap_key_here
FRONTEND_ORIGINS=https://agri-sense-lime.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# External APIs
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLOUD_VISION_KEY=your_google_cloud_vision_key_here
