# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/farmsaathi

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Chat modes: `pure_rag` for retrieval-first, `hybrid` for direct LLM path
CHAT_MODE=pure_rag
